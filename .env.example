NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ERP modules read and write Postgres directly from the server (transactions, audit, idempotency).
# Use the Supabase "Transaction pooler" connection string. Never expose it to the browser.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# require = encrypted, certificate not verified. verify = encrypted and verified. disable = no TLS (local only).
DATABASE_SSL=require
# AETHER_E2E is set only by scripts/e2e-local.mjs for a database on 127.0.0.1. Do not set it for Staging or Production.
# For verify, DATABASE_SSL_CA may hold the provider's CA certificate (public PEM, newlines written as \n). Without it the system authorities are used.
# DATABASE_SSL_CA=
