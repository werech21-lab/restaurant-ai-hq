NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ERP modules read and write Postgres directly from the server (transactions, audit, idempotency).
# Use the Supabase "Transaction pooler" connection string. Never expose it to the browser.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# require = encrypted, certificate not verified. verify = encrypted and verified. disable = no TLS (local only).
DATABASE_SSL=require
# AETHER_E2E is set only by scripts/e2e-local.mjs for a database on 127.0.0.1. Do not set it for Staging or Production.
# For verify, DATABASE_SSL_CA may hold the provider's CA certificate (public PEM, newlines written as \n). Without it the system authorities are used.
# DATABASE_SSL_CA=

# Marketing landing trial form → CRM + manager alerts (optional notify credentials).
# MARKETING_TENANT_SLUG=venture-foods-kuwait
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_MANAGER_PHONE=965xxxxxxxx

AUTH_SECRET="YOUR_AUTH_SECRET"

# Prisma erp-pro SQLite (never overwrite Postgres DATABASE_URL)
SQLITE_URL="file:./YOUR_DEV_DB.db"

# ==============================================================================
# Feryal AI & Smart Tools Gateway (Perplexity + Firecrawl + Playwright + Composio)
# ==============================================================================
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY
COMPOSIO_API_KEY=YOUR_COMPOSIO_API_KEY

# ==============================================================================
# Odoo 17 Live JSON-RPC Connector & Scheduled Sync (Server-Only — Never expose to browser)
# ==============================================================================
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
CRON_SECRET=

# Feryal council. Set values in the host environment. Model variables may stay empty; the server then uses its defaults.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
GEMINI_MODEL=
XAI_MODEL=
# Morning background analysis is scheduled while this is empty.
# Set it to 0 or false to skip the schedule. Models are called only when ANTHROPIC_API_KEY, GEMINI_API_KEY, and XAI_API_KEY are set.
AI_DAILY_BRIEF_ENABLED=
