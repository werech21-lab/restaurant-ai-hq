{
  "name": "restaurant-ai-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src scripts --ext .ts,.tsx,.js,.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:status:staging": "node --env-file=.env.staging scripts/migrate.mjs --status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import:venturefoods": "tsx scripts/import-venturefoods-odoo-dump.ts",
    "db:odoo-indexes": "tsx scripts/apply-odoo-indexes.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "ingest:direct": "tsx scripts/direct-db-ingest.ts",
    "ingest:desktop": "tsx scripts/direct-db-ingest.ts --scan-desktop-docs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "lucide-react": "^0.511.0",
    "next": "^15.5.28",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
