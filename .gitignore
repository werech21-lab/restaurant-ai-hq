# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local & environment secret files (strictly block all .env* except safe templates .env.example & .env.staging.example)
.env
.env.staging
.env.production
.env*.local
.env*
.env.*
!.env.example
!.env.staging.example

# typescript
*.tsbuildinfo

# local browser suite output
/playwright-report/
/test-results/
/blob-report/

# Supabase CLI cache. The project is not linked to a hosted database.
/supabase/.temp/

# HR zero-blob local object store (binaries never in SQL)
/data/hr-files/

# Vercel link metadata. It is not a secret, and it is not part of the app.
.vercel

# Local runtime state (locale preferences, temporary caches)
/.runtime/

# Audit / credentials / gate output / private keys
.creds
.creds*
gate-out/
*.key
