generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String       @id @default(cuid())
  name        String
  description String?
  isAdmin     Boolean      @default(false)
  permissions Permission[]
  users       User[]
}

model Permission {
  id        String  @id @default(cuid())
  roleId    String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  roleId       String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  role         Role                 @relation(fields: [roleId], references: [id])
  movements    StockMovement[]
  activityLogs ActivityLog[]
  payments     PaymentTransaction[]
  journalEntries JournalEntry[]
  transfers    StockTransfer[]
  leads        Lead[]
  quotations   Quotation[]

  @@index([email, roleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([module, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]

  @@index([name])
}

model Product {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  categoryId    String
  costPrice     Float
  sellingPrice  Float
  openingStock  Float               @default(0)
  currentStock  Float               @default(0)
  reorderLevel  Float               @default(0)
  customData    String              @default("{}")
  createdAt     DateTime            @default(now())
  category      Category            @relation(fields: [categoryId], references: [id])
  movements     StockMovement[]
  purchaseItems PurchaseOrderItem[]
  salesItems    SalesInvoiceItem[]
  warehouseStock WarehouseStock[]
  transferItems StockTransferItem[]
  quotationItems QuotationItem[]

  @@index([categoryId])
  @@index([name, code])
  @@index([currentStock, reorderLevel])
  @@index([createdAt])
}

model StockMovement {
  id           String   @id @default(cuid())
  productId    String
  type         String
  quantity     Float
  balanceAfter Float    @default(0)
  reference    String?
  note         String?
  warehouseId  String?
  createdById  String
  createdAt    DateTime @default(now())
  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy    User      @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([type])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  balance        Float           @default(0)
  customData     String          @default("{}")
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique
  supplierId  String
  totalAmount Float
  paidAmount  Float               @default(0)
  status      String
  createdAt   DateTime            @default(now())
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float
  totalCost       Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  balance       Float          @default(0)
  customData    String         @default("{}")
  createdAt     DateTime       @default(now())
  salesInvoices SalesInvoice[]
  quotations    Quotation[]

  @@index([name])
}

model SalesInvoice {
  id            String             @id @default(cuid())
  invoiceNumber String             @unique
  customerId    String
  subtotal      Float              @default(0)
  discount      Float              @default(0)
  totalAmount   Float
  paidAmount    Float              @default(0)
  status        String
  paymentMethod String             @default("MIXED")
  customData    String             @default("{}")
  warehouseId   String?
  createdAt     DateTime           @default(now())
  customer      Customer           @relation(fields: [customerId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  items         SalesInvoiceItem[]
  paymentLinks  PaymentLink[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
}

model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  productId      String
  quantity       Float
  unitPrice      Float
  totalPrice     Float
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@index([salesInvoiceId])
  @@index([productId])
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  type        String
  partyType   String
  partyId     String
  amount      Float
  reference   String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([partyType, partyId])
  @@index([createdAt])
  @@index([type])
}

model Account {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  type      String
  parentId  String?
  balance   Float              @default(0)
  parent    Account?           @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Account[]          @relation("AccountTree")
  lines     JournalEntryLine[]

  @@index([type])
  @@index([parentId])
}

model JournalEntry {
  id            String             @id @default(cuid())
  entryNumber   String             @unique
  date          DateTime           @default(now())
  description   String
  referenceType String
  referenceId   String?
  isPosted      Boolean            @default(true)
  createdById   String
  createdAt     DateTime           @default(now())
  createdBy     User               @relation(fields: [createdById], references: [id])
  lines         JournalEntryLine[]

  @@index([date])
  @@index([referenceType, referenceId])
  @@index([createdById])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model Warehouse {
  id           String            @id @default(cuid())
  name         String
  location     String?
  managerName  String?
  isDefault    Boolean           @default(false)
  stocks       WarehouseStock[]
  movements    StockMovement[]
  transfersOut StockTransfer[]   @relation("TransferFrom")
  transfersIn  StockTransfer[]   @relation("TransferTo")
  invoices     SalesInvoice[]

  @@index([name])
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float     @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String              @unique
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  createdById     String
  createdAt       DateTime            @default(now())
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy       User                @relation(fields: [createdById], references: [id])
  items           StockTransferItem[]

  @@index([createdAt])
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  productId       String
  quantity        Float
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([stockTransferId])
  @@index([productId])
}

model CustomFieldDefinition {
  id         String  @id @default(cuid())
  entityType String
  fieldName  String
  fieldType  String
  options    String  @default("")
  isActive   Boolean @default(true)

  @@unique([entityType, fieldName])
  @@index([entityType])
}

model AppModule {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  isEnabled   Boolean @default(true)
}

model AutomationRule {
  id         String   @id @default(cuid())
  name       String
  trigger    String
  action     String
  supplierId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([trigger, isActive])
}

model SystemNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  plan               String    @default("STARTER")
  currency           String    @default("KWD")
  taxRate            Float     @default(0)
  taxNumber          String?
  phone              String?
  address            String?
  invoiceFooter      String?
  logoUrl            String?
  enabledModules     String    @default("[]")
  isDefault          Boolean   @default(false)
  isActive           Boolean   @default(true)
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
  paymentLinks       PaymentLink[]

  @@index([plan, isActive])
}

model Lead {
  id            String      @id @default(cuid())
  title         String
  contactName   String
  phone         String?
  email         String?
  expectedValue Float       @default(0)
  stage         String      @default("NEW")
  assignedToId  String?
  notes         String?
  source        String      @default("")
  createdAt     DateTime    @default(now())
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  quotations    Quotation[]

  @@index([stage, createdAt])
  @@index([assignedToId])
  @@index([source, createdAt])
}

model SiteVisit {
  id        String   @id @default(cuid())
  source    String   @default("www.aetherbi.com")
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique
  customerId   String?
  leadId       String?
  totalAmount  Float
  validUntil   DateTime?
  status       String          @default("DRAFT")
  notes        String?
  createdById  String
  createdAt    DateTime        @default(now())
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  items        QuotationItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([leadId])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  productId    String
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model Employee {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  jobTitle    String
  department  String
  phone       String?
  basicSalary Float        @default(0)
  allowances  Float        @default(0)
  deductions  Float        @default(0)
  hireDate    DateTime     @default(now())
  status      String       @default("ACTIVE")
  attendance  Attendance[]
  payrolls    Payroll[]

  @@index([department, status])
  @@index([name])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String
  hoursWorked Float    @default(0)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date, status])
}

model Payroll {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  employeeId      String
  basicSalary     Float
  totalAllowances Float
  totalDeductions Float
  netSalary       Float
  absentDays      Int       @default(0)
  lateDays        Int       @default(0)
  status          String    @default("DRAFT")
  paidAt          DateTime?
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([year, month, status])
}

model PaymentGatewayConfig {
  id               String   @id @default(cuid())
  provider         String   @unique
  apiKey           String   @default("")
  webhookSecret    String   @default("")
  isTestMode       Boolean  @default(true)
  isActive         Boolean  @default(false)
  supportedMethods String   @default("[\"KNET\",\"VISA_MASTER\",\"APPLE_PAY\"]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

model PaymentLink {
  id                String        @id @default(cuid())
  token             String        @unique
  invoiceId         String?
  organizationId    String?
  amount            Float
  currency          String        @default("KWD")
  status            String        @default("PENDING")
  gatewayProvider   String
  externalReference String        @default("")
  method            String        @default("")
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  invoice           SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invoiceId])
  @@index([organizationId])
}

model NotificationSetting {
  id                   String   @id @default("default")
  telegramBotToken     String   @default("")
  telegramChatId       String   @default("")
  telegramChatName     String   @default("")
  whatsappMode         String   @default("CLICK")
  whatsappBridgeUrl    String   @default("")
  whatsappBridgeSecret String   @default("")
  metaPhoneNumberId    String   @default("")
  metaAccessToken      String   @default("")
  publicBaseUrl        String   @default("https://erp.aetherbi.com")
  updatedAt            DateTime @updatedAt
}
