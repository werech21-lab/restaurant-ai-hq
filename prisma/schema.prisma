generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Local erp-pro file DB. Runtime path is overridden in src/lib/db.ts so Postgres DATABASE_URL stays intact.
  url      = "file:./dev.db"
}

model Role {
  id          String       @id @default(cuid())
  name        String
  description String?
  isAdmin     Boolean      @default(false)
  permissions Permission[]
  users       User[]
}

model Permission {
  id        String  @id @default(cuid())
  roleId    String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  roleId       String
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  role         Role                 @relation(fields: [roleId], references: [id])
  movements    StockMovement[]
  activityLogs ActivityLog[]
  payments     PaymentTransaction[]
  journalEntries JournalEntry[]
  transfers    StockTransfer[]
  leads        Lead[]
  quotations   Quotation[]

  @@index([email, roleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([module, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]

  @@index([name])
}

model Product {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  categoryId    String
  costPrice     Float
  sellingPrice  Float
  openingStock  Float               @default(0)
  currentStock  Float               @default(0)
  reorderLevel  Float               @default(0)
  customData    String              @default("{}")
  createdAt     DateTime            @default(now())
  category      Category            @relation(fields: [categoryId], references: [id])
  movements     StockMovement[]
  purchaseItems PurchaseOrderItem[]
  salesItems    SalesInvoiceItem[]
  warehouseStock WarehouseStock[]
  transferItems StockTransferItem[]
  quotationItems QuotationItem[]
  menuRecipe    Recipe?
  recipeLines   RecipeLine[]        @relation("RecipeIngredient")

  @@index([categoryId])
  @@index([name, code])
  @@index([currentStock, reorderLevel])
  @@index([createdAt])
}

model StockMovement {
  id           String   @id @default(cuid())
  productId    String
  type         String
  quantity     Float
  balanceAfter Float    @default(0)
  reference    String?
  note         String?
  warehouseId  String?
  createdById  String
  createdAt    DateTime @default(now())
  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy    User      @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([type])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  balance        Float           @default(0)
  customData     String          @default("{}")
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String              @unique
  supplierId  String
  totalAmount Float
  paidAmount  Float               @default(0)
  status      String
  createdAt   DateTime            @default(now())
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Float
  unitCost        Float
  totalCost       Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  balance       Float          @default(0)
  customData    String         @default("{}")
  createdAt     DateTime       @default(now())
  salesInvoices SalesInvoice[]
  quotations    Quotation[]

  @@index([name])
}

model SalesInvoice {
  id            String             @id @default(cuid())
  invoiceNumber String             @unique
  customerId    String
  subtotal      Float              @default(0)
  discount      Float              @default(0)
  totalAmount   Float
  paidAmount    Float              @default(0)
  status        String
  paymentMethod String             @default("MIXED")
  customData    String             @default("{}")
  warehouseId   String?
  createdAt     DateTime           @default(now())
  customer      Customer           @relation(fields: [customerId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  items         SalesInvoiceItem[]
  paymentLinks  PaymentLink[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
}

model SalesInvoiceItem {
  id             String       @id @default(cuid())
  salesInvoiceId String
  productId      String
  quantity       Float
  unitPrice      Float
  totalPrice     Float
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@index([salesInvoiceId])
  @@index([productId])
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  type        String
  partyType   String
  partyId     String
  amount      Float
  reference   String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([partyType, partyId])
  @@index([createdAt])
  @@index([type])
}

model Account {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  type      String
  parentId  String?
  balance   Float              @default(0)
  parent    Account?           @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Account[]          @relation("AccountTree")
  lines     JournalEntryLine[]

  @@index([type])
  @@index([parentId])
}

model JournalEntry {
  id            String             @id @default(cuid())
  entryNumber   String             @unique
  date          DateTime           @default(now())
  description   String
  referenceType String
  referenceId   String?
  isPosted      Boolean            @default(true)
  createdById   String
  createdAt     DateTime           @default(now())
  createdBy     User               @relation(fields: [createdById], references: [id])
  lines         JournalEntryLine[]

  @@index([date])
  @@index([referenceType, referenceId])
  @@index([createdById])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

model Warehouse {
  id           String            @id @default(cuid())
  code         String?           @unique
  brandCode    String?
  name         String
  location     String?
  managerName  String?
  isDefault    Boolean           @default(false)
  stocks       WarehouseStock[]
  movements    StockMovement[]
  transfersOut StockTransfer[]   @relation("TransferFrom")
  transfersIn  StockTransfer[]   @relation("TransferTo")
  invoices     SalesInvoice[]

  @@index([name])
  @@index([brandCode])
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float     @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String              @unique
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  createdById     String
  createdAt       DateTime            @default(now())
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  createdBy       User                @relation(fields: [createdById], references: [id])
  items           StockTransferItem[]

  @@index([createdAt])
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  productId       String
  quantity        Float
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([stockTransferId])
  @@index([productId])
}

model CustomFieldDefinition {
  id         String  @id @default(cuid())
  entityType String
  fieldName  String
  fieldType  String
  options    String  @default("")
  isActive   Boolean @default(true)

  @@unique([entityType, fieldName])
  @@index([entityType])
}

model AppModule {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  isEnabled   Boolean @default(true)
}

model AutomationRule {
  id         String   @id @default(cuid())
  name       String
  trigger    String
  action     String
  supplierId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([trigger, isActive])
}

model SystemNotification {
  id        String   @id @default(cuid())
  title     String
  body      String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model Organization {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  plan               String    @default("STARTER")
  currency           String    @default("KWD")
  taxRate            Float     @default(0)
  taxNumber          String?
  phone              String?
  address            String?
  invoiceFooter      String?
  logoUrl            String?
  enabledModules     String    @default("[]")
  isDefault          Boolean   @default(false)
  isActive           Boolean   @default(true)
  subscriptionEndsAt DateTime?
  createdAt          DateTime  @default(now())
  paymentLinks       PaymentLink[]

  @@index([plan, isActive])
}

model Lead {
  id            String      @id @default(cuid())
  title         String
  contactName   String
  phone         String?
  email         String?
  expectedValue Float       @default(0)
  stage         String      @default("NEW")
  assignedToId  String?
  notes         String?
  source        String      @default("")
  createdAt     DateTime    @default(now())
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  quotations    Quotation[]

  @@index([stage, createdAt])
  @@index([assignedToId])
  @@index([source, createdAt])
}

model SiteVisit {
  id        String   @id @default(cuid())
  source    String   @default("www.aetherbi.com")
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model Quotation {
  id           String          @id @default(cuid())
  quoteNumber  String          @unique
  customerId   String?
  leadId       String?
  totalAmount  Float
  validUntil   DateTime?
  status       String          @default("DRAFT")
  notes        String?
  createdById  String
  createdAt    DateTime        @default(now())
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  items        QuotationItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([leadId])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  productId    String
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model Employee {
  id                     String       @id @default(cuid())
  /// Odoo barcode / fingerprint badge (indexed for ESS login + WPS export).
  code                   String       @unique
  name                   String
  jobTitle               String
  department             String
  phone                  String?
  basicSalary            Float        @default(0)
  allowances             Float        @default(0)
  deductions             Float        @default(0)
  hireDate               DateTime     @default(now())
  status                 String       @default("ACTIVE")
  /// bcrypt hash for /ess self-service PIN (default seeded as 1234).
  pinHash                String?
  civilId                String?
  iban                   String?
  bankName               String?
  civilIdExpiry          DateTime?
  passportExpiry         DateTime?
  healthCardExpiry       DateTime?
  workPermitExpiry       DateTime?
  drivingLicenseExpiry   DateTime?
  attendance             Attendance[]
  payrolls               Payroll[]
  hrDocuments            HrDocument[]

  @@index([department, status])
  @@index([name])
  @@index([code])
  @@index([civilIdExpiry])
  @@index([passportExpiry])
  @@index([healthCardExpiry])
  @@index([workPermitExpiry])
  @@index([drivingLicenseExpiry])
}

/// Smart folder ingest dossier row (panel SQLite) — Zero-Blob: never store large Base64 here.
model HrDocument {
  id            String    @id @default(cuid())
  employeeId    String?
  batchId       String
  fileName      String
  relativePath  String
  category      String
  mimeType      String    @default("application/octet-stream")
  sizeBytes     Int       @default(0)
  /// External object path / public API URL (Supabase Storage or local hr-files).
  fileUrl       String?
  fileType      String?
  /// Deprecated — kept nullable for migration; writers must leave this null.
  contentBase64 String?
  extractedText String?
  civilId       String?
  expiryDate    DateTime?
  matchScore    Float     @default(0)
  status        String    @default("MATCHED")
  updatesJson   String    @default("[]")
  metaJson      String    @default("{}")
  createdAt     DateTime  @default(now())
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, category])
  @@index([batchId, status])
  @@index([expiryDate])
  @@index([fileType])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String
  hoursWorked Float    @default(0)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date, status])
}

model Payroll {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  employeeId      String
  basicSalary     Float
  totalAllowances Float
  totalDeductions Float
  netSalary       Float
  absentDays      Int       @default(0)
  lateDays        Int       @default(0)
  status          String    @default("DRAFT")
  paidAt          DateTime?
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@index([year, month, status])
}

model PaymentGatewayConfig {
  id               String   @id @default(cuid())
  provider         String   @unique
  apiKey           String   @default("")
  webhookSecret    String   @default("")
  isTestMode       Boolean  @default(true)
  isActive         Boolean  @default(false)
  supportedMethods String   @default("[\"KNET\",\"VISA_MASTER\",\"APPLE_PAY\"]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

model PaymentLink {
  id                String        @id @default(cuid())
  token             String        @unique
  invoiceId         String?
  organizationId    String?
  amount            Float
  currency          String        @default("KWD")
  status            String        @default("PENDING")
  gatewayProvider   String
  externalReference String        @default("")
  method            String        @default("")
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  invoice           SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([invoiceId])
  @@index([organizationId])
}

model NotificationSetting {
  id                   String   @id @default("default")
  telegramBotToken     String   @default("")
  telegramChatId       String   @default("")
  telegramChatName     String   @default("")
  whatsappMode         String   @default("CLICK")
  whatsappBridgeUrl    String   @default("")
  whatsappBridgeSecret String   @default("")
  metaPhoneNumberId    String   @default("")
  metaAccessToken      String   @default("")
  publicBaseUrl        String   @default("https://erp.aetherbi.com")
  updatedAt            DateTime @updatedAt
}

// Menu BOM: one recipe per sellable menu product.
model Recipe {
  id                    String       @id @default(cuid())
  menuProductId         String       @unique
  name                  String
  nameEn                String       @default("")
  brandCode             String?
  wastagePercent        Float        @default(0)
  targetFoodCostPercent Float        @default(32)
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  menuProduct           Product      @relation(fields: [menuProductId], references: [id], onDelete: Cascade)
  lines                 RecipeLine[]

  @@index([brandCode, active])
}

model RecipeLine {
  id                   String  @id @default(cuid())
  recipeId             String
  ingredientProductId  String
  quantity             Float
  unit                 String  @default("g")
  wastagePercent       Float   @default(0)
  recipe               Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient           Product @relation("RecipeIngredient", fields: [ingredientProductId], references: [id])

  @@index([recipeId])
  @@index([ingredientProductId])
}

model DeliveryPlatform {
  id                 String          @id @default(cuid())
  code               String          @unique
  nameAr             String
  nameEn             String
  commissionPercent  Float           @default(15)
  fixedFeeKwd        Float           @default(0)
  isActive           Boolean         @default(true)
  sortOrder          Int             @default(0)
  orders             DeliveryOrder[]
  settlements        DeliverySettlement[]

  @@index([isActive, sortOrder])
}

model DeliveryOrder {
  id              String           @id @default(cuid())
  platformCode    String
  invoiceId       String?
  invoiceNumber   String           @default("")
  brandCode       String?
  branchCode      String?
  warehouseId     String?
  grossAmount     Float
  commissionAmount Float           @default(0)
  deliveryFee     Float            @default(0)
  marketingDiscount Float          @default(0)
  netPayout       Float            @default(0)
  status          String           @default("OPEN")
  settledAt       DateTime?
  settlementId    String?
  createdAt       DateTime         @default(now())
  platform        DeliveryPlatform @relation(fields: [platformCode], references: [code])
  settlement      DeliverySettlement? @relation(fields: [settlementId], references: [id])

  @@index([platformCode, status, createdAt])
  @@index([brandCode, branchCode])
  @@index([invoiceId])
}

model DeliverySettlement {
  id               String          @id @default(cuid())
  platformCode     String
  brandCode        String?
  periodLabel      String
  grossAmount      Float
  commissionAmount Float
  deliveryFee      Float           @default(0)
  marketingDiscount Float          @default(0)
  netPayout        Float
  journalEntryId   String?
  status           String          @default("POSTED")
  createdById      String
  createdAt        DateTime        @default(now())
  platform         DeliveryPlatform @relation(fields: [platformCode], references: [code])
  orders           DeliveryOrder[]

  @@index([platformCode, createdAt])
}

model KitchenTicket {
  id            String              @id @default(cuid())
  ticketNumber  String              @unique
  invoiceId     String?
  brandCode     String?
  branchCode    String?
  warehouseId   String?
  orderType     String              @default("dine_in")
  tableNo       String              @default("")
  status        String              @default("NEW")
  notes         String              @default("")
  createdById   String?
  createdAt     DateTime            @default(now())
  startedAt     DateTime?
  readyAt       DateTime?
  items         KitchenTicketItem[]

  @@index([status, createdAt])
  @@index([brandCode, branchCode])
  @@index([warehouseId, status])
}

model KitchenTicketItem {
  id        String        @id @default(cuid())
  ticketId  String
  productId String?
  name      String
  quantity  Float
  note      String        @default("")
  isDone    Boolean       @default(false)
  ticket    KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
