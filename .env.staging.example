# Staging ONLY. Copy to .env.staging (which git ignores) and fill in values from the STAGING project.
# Never put Production values in this file, and never put real values in this example.
#
# Remote migrations are refused until the project ref is listed in database/approved-staging-targets.json
# and the same ref is passed here. The check runs before any connection. The list ships empty.
#   node --env-file=.env.staging scripts/migrate.mjs --status --expect-host <project-ref> --i-understand-this-is-staging
# The validators refuse to run unless --expect-host matches the project reference in DATABASE_URL:
#   node --env-file=.env.staging scripts/staging-validate.mjs --expect-host <project-ref> --i-understand-this-is-staging

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Server-only. Direct or session-pooler connection of the STAGING project.
DATABASE_URL=postgresql://postgres.YOUR_STAGING_PROJECT:YOUR_STAGING_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=require
# DATABASE_SSL_CA=

# There is deliberately no service-role key here. The application never uses one.