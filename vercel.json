{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/erp/odoo-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/aggregator-radar/alert",
      "schedule": "59 20 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.aetherbi.com"
        }
      ],
      "destination": "https://aetherbi.com/:path*",
      "permanent": true
    }
  ]
}
